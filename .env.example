# =====================================================================
# Variables d'environnement du portail RAG
# ---------------------------------------------------------------------
# Copiez ce fichier vers `.env` puis renseignez les valeurs :
#     cp .env.example .env
# Le fichier `.env` n'est JAMAIS versionné (voir .gitignore).
# =====================================================================

# --- Pipeline RAG Droit (lecture seule) ---
# Racine du pipeline RAG Droit (défaut /opt/rag).
# PORTAIL_RAG_BASE=/opt/rag
# Racine du Vault Obsidian généré.
# PORTAIL_VAULT_DIR=/opt/rag/Vault_Obsidian
# Chemin du corpus JSONL produit par le pipeline (utilisé par les scripts de build).
# PORTAIL_JSONL=/opt/rag/donnees_traitees/corpus_global.jsonl

# --- Base vectorielle Qdrant ---
# PORTAIL_QDRANT_URL=http://localhost:6333
# PORTAIL_COLLECTION=rag_droit

# --- Embedding (Ollama local, bge-m3) ---
# PORTAIL_OLLAMA_URL=http://localhost:11434
# PORTAIL_EMBED_MODEL=bge-m3
# PORTAIL_EMBED_TIMEOUT=120

# --- Index SQLite local ---
# PORTAIL_INDEX_DB=data/index.db

# --- Recherche ---
# PORTAIL_SEARCH_LIMIT=10

# --- Assistant IA (LLM OpenAI-compatible) ---
# PORTAIL_RAG_TOP_K=5
# PORTAIL_RAG_CONTEXT_CHARS=12000

# --- Favoris ---
# PORTAIL_FAVORITES_PATH=data/favorites.json
